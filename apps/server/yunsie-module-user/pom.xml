<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.yunsie</groupId>
        <artifactId>yunsie-server</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>yunsie-module-user</artifactId>
    <name>yunsie-module-user</name>
    <description>user 域：学员/教师账号、用户资料、会话、学习档案（learning-profile）。依赖 sys（角色）。</description>

    <dependencies>
        <dependency>
            <groupId>com.yunsie</groupId>
            <artifactId>yunsie-server-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.yunsie</groupId>
            <artifactId>yunsie-module-sys</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 领域基础设施：Web(Controller) / ORM(Mapper) / 校验 / 密码哈希 / Lombok -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>
        <!-- @PreAuthorize 权限点校验（permission-rbac：Controller 层统一机制） -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
