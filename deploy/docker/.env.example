# 运行配置示例 —— 复制为 deploy/docker/.env（已被 .gitignore 忽略）
# 全部为开发占位默认值；生产部署必须逐项覆盖，禁止把真实生产凭据写入仓库

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=devpassword          # secret：生产必须替换
MYSQL_DATABASE=yunsie_platform
MYSQL_USER=root                          # 生产建议创建最小权限账号

# ---- Redis ----
REDIS_PORT=6379

# ---- MinIO ----
MINIO_ROOT_USER=minioadmin               # secret：生产必须替换
MINIO_ROOT_PASSWORD=minioadmin           # secret：生产必须替换
MINIO_BUCKET=yunsie-videos
# 浏览器可达的 MinIO 地址（预签名播放 URL 的 Host；本机部署默认即可；远程部署需改为对外地址）
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
# MinIO 区域（预签名显式区域，容器内预签名不发 region 发现请求；默认 us-east-1 与 MinIO 默认一致）
MINIO_REGION=us-east-1

# ---- 应用 ----
# JWT 签名密钥（secret）：生产必须为随机长字符串（≥32 字符）
YUNSIE_JWT_SECRET=dev-only-secret-please-change-0123456789abcdefghij
# server JVM 参数（可空；默认 -XX:MaxRAMPercentage=75.0）
SERVER_JAVA_OPTS=-XX:MaxRAMPercentage=75.0

# ---- Demo 演示入口（Stage 2.1）----
# 本地演示：true → 后端提供 /demo-login 一键登录端点、前端出现「进入 Demo」按钮
# 生产环境必须设为 false（端点随开关不存在；真实登录与权限不受影响）
YUNSIE_DEMO_ENABLED=true
YUNSIE_DEMO_USERNAME=demo_learner
# 演示三角色账号（demo-login 的 role=teacher/admin 分别指向以下账号；admin 默认指向种子管理员）
YUNSIE_DEMO_TEACHER_USERNAME=demo_teacher
YUNSIE_DEMO_ADMIN_USERNAME=admin

# ---- AI 服务（接入真实模型时再配置，本阶段留空）----
AI_INTERNAL_API_SECRET=
AI_PROVIDERS__DEEPSEEK__BASE_URL=
AI_PROVIDERS__DEEPSEEK__API_KEY=
